  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dashchat",
    "dashboard",
    "voice-assistant",
    "capability-runtime",
    "gemini",
    "nextjs",
    "typescript"
  ],
  "license": "MIT"
}
