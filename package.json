{
  "name": "dash-chat",
  "version": "0.1.0",
  "private": true,
  "description": "DashChat — a smart way to talk to your dashboards. Framework-agnostic capability runtime (@dashchat/sdk) plus a Next.js demo dashboard (Northgrid).",
